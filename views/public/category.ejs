<div>
    <!-- Category Header -->
    <div class="bg-white rounded-lg shadow-md p-8 mb-8">
        <div class="flex items-center space-x-4 mb-4">
            <div class="w-16 h-16 rounded-full flex items-center justify-center text-white text-2xl font-bold"
                 style="background-color: <%= category.color %>">
                <%= category.name.charAt(0) %>
            </div>
            <div>
                <h1 class="text-4xl font-bold"><%= category.name %></h1>
                <% if (category.description) { %>
                    <p class="text-gray-600 mt-2"><%= category.description %></p>
                <% } %>
            </div>
        </div>
        <p class="text-sm text-gray-500">
            <%= posts.length %> post<%= posts.length !== 1 ? 's' : '' %> in this category
        </p>
    </div>
    
    <!-- Posts Grid -->
    <% if (posts.length === 0) { %>
        <div class="bg-white rounded-lg shadow-md p-12 text-center">
            <p class="text-gray-500 text-lg">No posts in this category yet.</p>
            <a href="/" class="text-blue-600 hover:underline mt-4 inline-block">
                ← Back to home
            </a>
        </div>
    <% } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <% posts.forEach(post => { %>
                <article class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
                    <% if (post.featuredImage) { %>
                        <img src="<%= post.featuredImage %>" 
                             alt="<%= post.title %>" 
                             class="w-full h-48 object-cover">
                    <% } %>
                    
                    <div class="p-6">
                        <h2 class="text-2xl font-bold mb-2">
                            <a href="/post/<%= post.slug %>" class="hover:text-blue-600">
                                <%= post.title %>
                            </a>
                        </h2>
                        
                        <div class="text-sm text-gray-500 mb-3">
                            <span>By <%= post.author ? post.author.displayName : 'Unknown' %></span>
                            <span class="mx-2">•</span>
                            <span><%= formatDate(post.publishedAt) %></span>
                        </div>
                        
                        <p class="text-gray-700 mb-4">
                            <%= post.excerpt || truncate(post.content) %>
                        </p>
                        
                        <a href="/post/<%= post.slug %>" 
                           class="text-blue-600 hover:underline font-medium">
                            Read more →
                        </a>
                    </div>
                </article>
            <% }) %>
        </div>
        
        <!-- Pagination -->
        <% if (totalPages > 1) { %>
            <div class="flex justify-center space-x-2">
                <% if (currentPage > 1) { %>
                    <a href="/category/<%= category.slug %>?page=<%= currentPage - 1 %>" 
                       class="px-4 py-2 bg-white text-gray-700 rounded hover:bg-gray-100">
                        ← Previous
                    </a>
                <% } %>
                
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <a href="/category/<%= category.slug %>?page=<%= i %>" 
                       class="px-4 py-2 <%= i === currentPage ? 'bg-blue-600 text-white' : 'bg-white text-gray-700' %> rounded hover:bg-blue-500 hover:text-white">
                        <%= i %>
                    </a>
                <% } %>
                
                <% if (currentPage < totalPages) { %>
                    <a href="/category/<%= category.slug %>?page=<%= currentPage + 1 %>" 
                       class="px-4 py-2 bg-white text-gray-700 rounded hover:bg-gray-100">
                        Next →
                    </a>
                <% } %>
            </div>
        <% } %>
    <% } %>
</div>