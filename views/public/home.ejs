<!-- views/public/home.ejs -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Main content -->
    <div class="lg:col-span-2">
        <h1 class="text-4xl font-bold mb-8">Latest Posts</h1>
        
        <% if (posts.length === 0) { %>
            <p class="text-gray-600">No posts yet. Check back soon!</p>
        <% } else { %>
            <div class="space-y-8">
                <% posts.forEach(post => { %>
                    <article class="bg-white rounded-lg shadow-md p-6">
                        <h2 class="text-2xl font-bold mb-2">
                            <a href="/post/<%= post.slug %>" class="hover:text-blue-600">
                                <%= post.title %>
                            </a>
                        </h2>
                        
                        <div class="text-sm text-gray-500 mb-4 flex items-center space-x-4">
                            <span>By <%= post.author ? post.author.displayName : 'Unknown' %></span>
                            <span>•</span>
                            <span><%= formatDate(post.publishedAt) %></span>
                            <% if (post.category) { %>
                                <span>•</span>
                                <a href="/category/<%= post.category.slug %>" 
                                   class="text-blue-600 hover:underline">
                                    <%= post.category.name %>
                                </a>
                            <% } %>
                        </div>
                        
                        <p class="text-gray-700 mb-4">
                            <%= post.excerpt || truncate(post.content) %>
                        </p>
                        
                        <a href="/post/<%= post.slug %>" 
                           class="text-blue-600 hover:underline font-medium">
                            Read more →
                        </a>
                    </article>
                <% }) %>
            </div>
            
            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <div class="mt-8 flex justify-center space-x-2">
                    <% for(let i = 1; i <= totalPages; i++) { %>
                        <a href="/?page=<%= i %>" 
                           class="px-4 py-2 <%= i === currentPage ? 'bg-blue-600 text-white' : 'bg-white text-gray-700' %> rounded hover:bg-blue-500 hover:text-white">
                            <%= i %>
                        </a>
                    <% } %>
                </div>
            <% } %>
        <% } %>
    </div>
    
    <!-- Sidebar -->
    <div class="lg:col-span-1">
        <!-- Search -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-bold mb-4">Search</h3>
            <form action="/search" method="GET">
                <input type="text" 
                       name="q" 
                       placeholder="Search posts..." 
                       class="w-full px-4 py-2 border rounded">
            </form>
        </div>
        
        <!-- Categories -->
        <div class="bg-white rounded-lg shadow-md p-6 mb-6">
            <h3 class="text-xl font-bold mb-4">Categories</h3>
            <ul class="space-y-2">
                <% categories.forEach(cat => { %>
                    <li>
                        <a href="/category/<%= cat.slug %>" 
                           class="flex items-center hover:text-blue-600">
                            <span class="w-3 h-3 rounded-full mr-2" 
                                  style="background-color: <%= cat.color %>"></span>
                            <%= cat.name %>
                        </a>
                    </li>
                <% }) %>
            </ul>
        </div>
        
        <!-- Recent Posts -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-xl font-bold mb-4">Recent Posts</h3>
            <ul class="space-y-3">
                <% recentPosts.forEach(post => { %>
                    <li>
                        <a href="/post/<%= post.slug %>" 
                           class="text-sm hover:text-blue-600">
                            <%= post.title %>
                        </a>
                        <div class="text-xs text-gray-500 mt-1">
                            <%= timeAgo(post.publishedAt) %>
                        </div>
                    </li>
                <% }) %>
            </ul>
        </div>
    </div>
</div>

<!-- ================================ -->
<!-- views/auth/login.ejs -->
<!-- ================================ -->
<div class="max-w-md mx-auto">
    <div class="bg-white rounded-lg shadow-md p-8">
        <h1 class="text-3xl font-bold mb-6 text-center">Login</h1>
        
        <form action="/auth/login" method="POST">
            <div class="mb-4">
                <label class="block text-gray-700 font-medium mb-2">Username</label>
                <input type="text" 
                       name="username" 
                       required 
                       class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div class="mb-6">
                <label class="block text-gray-700 font-medium mb-2">Password</label>
                <input type="password" 
                       name="password" 
                       required 
                       class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <button type="submit" 
                    class="w-full bg-blue-600 text-white py-2 rounded hover:bg-blue-700">
                Login
            </button>
        </form>
        
        <p class="mt-4 text-center text-gray-600">
            Don't have an account? 
            <a href="/auth/register" class="text-blue-600 hover:underline">Register</a>
        </p>
    </div>
</div>

<!-- ================================ -->
<!-- views/admin/dashboard.ejs -->
<!-- ================================ -->
<div>
    <h1 class="text-4xl font-bold mb-8">Dashboard</h1>
    
    <!-- Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-gray-500 text-sm font-medium">Total Posts</h3>
            <p class="text-3xl font-bold text-blue-600"><%= stats.totalPosts %></p>
            <p class="text-sm text-gray-500 mt-2">
                <%= stats.publishedPosts %> published, 
                <%= stats.draftPosts %> drafts
            </p>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-gray-500 text-sm font-medium">Comments</h3>
            <p class="text-3xl font-bold text-green-600"><%= stats.totalComments %></p>
            <% if (stats.pendingComments > 0) { %>
                <p class="text-sm text-orange-500 mt-2">
                    <%= stats.pendingComments %> pending approval
                </p>
            <% } %>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-gray-500 text-sm font-medium">Categories</h3>
            <p class="text-3xl font-bold text-purple-600"><%= stats.categories %></p>
        </div>
    </div>
    
    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <a href="/admin/posts/new" 
           class="bg-blue-600 text-white rounded-lg p-6 text-center hover:bg-blue-700">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <h3 class="text-xl font-bold">New Post</h3>
        </a>
        
        <a href="/admin/comments?status=pending" 
           class="bg-orange-600 text-white rounded-lg p-6 text-center hover:bg-orange-700">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
            </svg>
            <h3 class="text-xl font-bold">Moderate Comments</h3>
            <% if (stats.pendingComments > 0) { %>
                <span class="inline-block mt-2 px-3 py-1 bg-white text-orange-600 rounded-full text-sm font-medium">
                    <%= stats.pendingComments %> pending
                </span>
            <% } %>
        </a>
    </div>
    
    <!-- Recent Posts -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold mb-4">Recent Posts</h2>
        <div class="space-y-4">
            <% recentPosts.forEach(post => { %>
                <div class="flex justify-between items-center border-b pb-4">
                    <div>
                        <a href="/post/<%= post.slug %>" 
                           class="text-lg font-medium hover:text-blue-600">
                            <%= post.title %>
                        </a>
                        <p class="text-sm text-gray-500">
                            <%= timeAgo(post.createdAt) %> • 
                            <span class="px-2 py-1 text-xs rounded
                                <%= post.status === 'published' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                <%= post.status %>
                            </span>
                        </p>
                    </div>
                    <a href="/admin/posts/<%= post.id %>/edit" 
                       class="text-blue-600 hover:underline">
                        Edit
                    </a>
                </div>
            <% }) %>
        </div>
    </div>
</div>

