<div class="max-w-4xl mx-auto">
    <!-- Post Header -->
    <article class="bg-white rounded-lg shadow-lg overflow-hidden mb-8">
        <% if (post.featuredImage) { %>
            <img src="<%= post.featuredImage %>" 
                 alt="<%= post.title %>" 
                 class="w-full h-96 object-cover">
        <% } %>
        
        <div class="p-8">
            <!-- Category Badge -->
            <% if (post.category) { %>
                <a href="/category/<%= post.category.slug %>" 
                   class="inline-block px-3 py-1 rounded-full text-sm font-medium mb-4"
                   style="background-color: <%= post.category.color %>20; color: <%= post.category.color %>">
                    <%= post.category.name %>
                </a>
            <% } %>
            
            <!-- Title -->
            <h1 class="text-4xl md:text-5xl font-bold mb-4 leading-tight">
                <%= post.title %>
            </h1>
            
            <!-- Meta Info -->
            <div class="flex items-center space-x-4 text-gray-600 mb-6 pb-6 border-b">
                <% if (post.author) { %>
                    <div class="flex items-center space-x-2">
                        <img src="<%= post.author.avatar || '/images/default-avatar.png' %>" 
                             alt="<%= post.author.displayName %>" 
                             class="w-10 h-10 rounded-full">
                        <span class="font-medium"><%= post.author.displayName %></span>
                    </div>
                <% } %>
                <span>•</span>
                <span><%= formatDate(post.publishedAt) %></span>
                <span>•</span>
                <span><%= post.views %> views</span>
            </div>
            
            <!-- Tags -->
            <% if (post.tags && post.tags.length > 0) { %>
                <div class="flex flex-wrap gap-2 mb-6">
                    <% post.tags.forEach(tag => { %>
                        <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
                            #<%= tag %>
                        </span>
                    <% }) %>
                </div>
            <% } %>
            
            <!-- Content -->
            <div class="prose prose-lg max-w-none">
                <%- post.content.replace(/\n/g, '<br>') %>
            </div>
            
            <!-- Share Buttons -->
            <div class="mt-8 pt-8 border-t">
                <h3 class="text-lg font-bold mb-4">Share this post</h3>
                <div class="flex space-x-4">
                    <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(post.title) %>&url=<%= encodeURIComponent(process.env.SITE_URL || 'http://localhost:3000') %>/post/<%= post.slug %>" 
                       target="_blank"
                       class="px-4 py-2 bg-blue-400 text-white rounded hover:bg-blue-500">
                        Twitter
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(process.env.SITE_URL || 'http://localhost:3000') %>/post/<%= post.slug %>" 
                       target="_blank"
                       class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                        Facebook
                    </a>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(process.env.SITE_URL || 'http://localhost:3000') %>/post/<%= post.slug %>" 
                       target="_blank"
                       class="px-4 py-2 bg-blue-700 text-white rounded hover:bg-blue-800">
                        LinkedIn
                    </a>
                </div>
            </div>
        </div>
    </article>
    
    <!-- Related Posts -->
    <% if (relatedPosts && relatedPosts.length > 0) { %>
        <div class="mb-8">
            <h2 class="text-2xl font-bold mb-4">Related Posts</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <% relatedPosts.forEach(related => { %>
                    <a href="/post/<%= related.slug %>" 
                       class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition">
                        <div class="p-4">
                            <h3 class="font-bold mb-2 hover:text-blue-600">
                                <%= related.title %>
                            </h3>
                            <p class="text-sm text-gray-600">
                                <%= related.excerpt || truncate(related.content, 100) %>
                            </p>
                            <p class="text-xs text-gray-500 mt-2">
                                <%= formatDate(related.publishedAt) %>
                            </p>
                        </div>
                    </a>
                <% }) %>
            </div>
        </div>
    <% } %>
    
    <!-- Comments Section -->
    <div class="bg-white rounded-lg shadow-lg p-8" id="comments">
        <h2 class="text-2xl font-bold mb-6">
            Comments (<%= comments.length %>)
        </h2>
        
        <!-- Comment Form -->
        <form action="/post/<%= post.slug %>/comment" method="POST" class="mb-8 pb-8 border-b">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-sm font-medium mb-2">Name *</label>
                    <input type="text" 
                           name="name" 
                           required 
                           value="<%= currentUser ? currentUser.displayName : '' %>"
                           class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-sm font-medium mb-2">Email *</label>
                    <input type="email" 
                           name="email" 
                           required 
                           value="<%= currentUser ? currentUser.email : '' %>"
                           class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>
            
            <div class="mb-4">
                <label class="block text-sm font-medium mb-2">Comment *</label>
                <textarea name="content" 
                          rows="4" 
                          required 
                          class="w-full px-4 py-2 border rounded focus:outline-none focus:ring-2 focus:ring-blue-500"
                          placeholder="Share your thoughts..."></textarea>
            </div>
            
            <button type="submit" 
                    class="px-6 py-2 bg-blue-600 text-white rounded hover:bg-blue-700">
                Post Comment
            </button>
            
            <p class="text-sm text-gray-500 mt-2">
                Your comment will be reviewed before being published.
            </p>
        </form>
        
        <!-- Comments List -->
        <div class="space-y-6">
            <% if (comments.length === 0) { %>
                <p class="text-gray-500 text-center py-8">
                    No comments yet. Be the first to comment!
                </p>
            <% } else { %>
                <% comments.forEach(comment => { %>
                    <div class="border-b pb-6">
                        <div class="flex items-start space-x-4">
                            <div class="w-10 h-10 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold">
                                <%= comment.authorName.charAt(0).toUpperCase() %>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center space-x-2 mb-2">
                                    <span class="font-bold"><%= comment.authorName %></span>
                                    <span class="text-gray-500 text-sm">
                                        <%= timeAgo(comment.createdAt) %>
                                    </span>
                                </div>
                                <p class="text-gray-700"><%= comment.content %></p>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } %>
        </div>
    </div>
</div>