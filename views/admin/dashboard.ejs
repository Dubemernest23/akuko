<div>
    <h1 class="text-4xl font-bold mb-8">Dashboard</h1>
    
    <!-- Statistics -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-gray-500 text-sm font-medium">Total Posts</h3>
            <p class="text-3xl font-bold text-blue-600"><%= stats.totalPosts %></p>
            <p class="text-sm text-gray-500 mt-2">
                <%= stats.publishedPosts %> published, 
                <%= stats.draftPosts %> drafts
            </p>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-gray-500 text-sm font-medium">Comments</h3>
            <p class="text-3xl font-bold text-green-600"><%= stats.totalComments %></p>
            <% if (stats.pendingComments > 0) { %>
                <p class="text-sm text-orange-500 mt-2">
                    <%= stats.pendingComments %> pending approval
                </p>
            <% } %>
        </div>
        
        <div class="bg-white rounded-lg shadow-md p-6">
            <h3 class="text-gray-500 text-sm font-medium">Categories</h3>
            <p class="text-3xl font-bold text-purple-600"><%= stats.categories %></p>
        </div>
    </div>
    
    <!-- Quick Actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
        <a href="/admin/posts/new" 
           class="bg-blue-600 text-white rounded-lg p-6 text-center hover:bg-blue-700">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
            </svg>
            <h3 class="text-xl font-bold">New Post</h3>
        </a>
        
        <a href="/admin/comments?status=pending" 
           class="bg-orange-600 text-white rounded-lg p-6 text-center hover:bg-orange-700">
            <svg class="w-12 h-12 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
            </svg>
            <h3 class="text-xl font-bold">Moderate Comments</h3>
            <% if (stats.pendingComments > 0) { %>
                <span class="inline-block mt-2 px-3 py-1 bg-white text-orange-600 rounded-full text-sm font-medium">
                    <%= stats.pendingComments %> pending
                </span>
            <% } %>
        </a>
    </div>
    
    <!-- Recent Posts -->
    <div class="bg-white rounded-lg shadow-md p-6 mb-6">
        <h2 class="text-2xl font-bold mb-4">Recent Posts</h2>
        <div class="space-y-4">
            <% recentPosts.forEach(post => { %>
                <div class="flex justify-between items-center border-b pb-4">
                    <div>
                        <a href="/post/<%= post.slug %>" 
                           class="text-lg font-medium hover:text-blue-600">
                            <%= post.title %>
                        </a>
                        <p class="text-sm text-gray-500">
                            <%= timeAgo(post.createdAt) %> • 
                            <span class="px-2 py-1 text-xs rounded
                                <%= post.status === 'published' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                <%= post.status %>
                            </span>
                        </p>
                    </div>
                    <a href="/admin/posts/<%= post.id %>/edit" 
                       class="text-blue-600 hover:underline">
                        Edit
                    </a>
                </div>
            <% }) %>
        </div>
    </div>
</div>