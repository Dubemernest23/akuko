<div>
    <h1 class="text-4xl font-bold mb-8">Comments</h1>
    
    <!-- Filter Tabs -->
    <div class="bg-white rounded-lg shadow-md mb-6">
        <div class="flex border-b">
            <a href="/admin/comments?status=all" 
               class="px-6 py-4 <%= currentStatus === 'all' ? 'border-b-2 border-blue-600 text-blue-600 font-medium' : 'text-gray-600 hover:text-gray-900' %>">
                All Comments
            </a>
            <a href="/admin/comments?status=pending" 
               class="px-6 py-4 <%= currentStatus === 'pending' ? 'border-b-2 border-orange-600 text-orange-600 font-medium' : 'text-gray-600 hover:text-gray-900' %>">
                Pending
            </a>
            <a href="/admin/comments?status=approved" 
               class="px-6 py-4 <%= currentStatus === 'approved' ? 'border-b-2 border-green-600 text-green-600 font-medium' : 'text-gray-600 hover:text-gray-900' %>">
                Approved
            </a>
        </div>
    </div>
    
    <!-- Comments List -->
    <div class="space-y-4">
        <% if (comments.length === 0) { %>
            <div class="bg-white rounded-lg shadow-md p-12 text-center">
                <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path>
                </svg>
                <p class="text-gray-500 text-lg">No comments found</p>
            </div>
        <% } else { %>
            <% comments.forEach(comment => { %>
                <div class="bg-white rounded-lg shadow-md p-6">
                    <div class="flex items-start justify-between mb-4">
                        <div class="flex items-start space-x-4 flex-1">
                            <div class="w-12 h-12 bg-blue-600 text-white rounded-full flex items-center justify-center font-bold text-lg">
                                <%= comment.authorName.charAt(0).toUpperCase() %>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center space-x-3 mb-2">
                                    <span class="font-bold text-lg"><%= comment.authorName %></span>
                                    <span class="text-gray-500 text-sm"><%= comment.authorEmail %></span>
                                    <span class="px-2 py-1 text-xs font-medium rounded
                                        <%= comment.isApproved ? 'bg-green-100 text-green-800' : 'bg-orange-100 text-orange-800' %>">
                                        <%= comment.isApproved ? 'Approved' : 'Pending' %>
                                    </span>
                                </div>
                                
                                <p class="text-gray-700 mb-3"><%= comment.content %></p>
                                
                                <div class="flex items-center space-x-4 text-sm text-gray-500">
                                    <span>
                                        <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <%= timeAgo(comment.createdAt) %>
                                    </span>
                                    <% if (comment.post) { %>
                                        <span>•</span>
                                        <a href="/post/<%= comment.post.slug %>" 
                                           target="_blank"
                                           class="text-blue-600 hover:underline">
                                            On: <%= comment.post.title %>
                                        </a>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        
                        <!-- Actions -->
                        <div class="flex space-x-2">
                            <% if (!comment.isApproved) { %>
                                <form action="/admin/comments/<%= comment.id %>/approve" method="POST">
                                    <button type="submit" 
                                            class="px-4 py-2 bg-green-600 text-white rounded hover:bg-green-700 text-sm font-medium">
                                        Approve
                                    </button>
                                </form>
                            <% } %>
                            
                            <form action="/admin/comments/<%= comment.id %>?_method=DELETE" 
                                  method="POST"
                                  onsubmit="return confirm('Are you sure you want to delete this comment?')">
                                <button type="submit" 
                                        class="px-4 py-2 bg-red-600 text-white rounded hover:bg-red-700 text-sm font-medium">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } %>
    </div>
</div>