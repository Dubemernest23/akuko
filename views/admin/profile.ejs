<div class="max-w-4xl mx-auto">
    <h1 class="text-4xl font-bold mb-8">Profile</h1>
    
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <!-- Profile Info -->
        <div class="md:col-span-1">
            <div class="bg-white rounded-lg shadow-md p-6 text-center">
                <div class="w-32 h-32 mx-auto bg-blue-600 text-white rounded-full flex items-center justify-center text-4xl font-bold mb-4">
                    <%= user.displayName.charAt(0).toUpperCase() %>
                </div>
                <h2 class="text-2xl font-bold mb-2"><%= user.displayName %></h2>
                <p class="text-gray-600 mb-4">@<%= user.username %></p>
                <span class="inline-block px-3 py-1 text-sm font-medium rounded-full
                    <%= user.role === 'admin' ? 'bg-purple-100 text-purple-800' : 'bg-blue-100 text-blue-800' %>">
                    <%= user.role %>
                </span>
                
                <div class="mt-6 pt-6 border-t text-left space-y-2 text-sm">
                    <div class="flex items-center text-gray-600">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        Joined <%= formatDate(user.createdAt) %>
                    </div>
                    <div class="flex items-center text-gray-600">
                        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        Last updated <%= timeAgo(user.updatedAt) %>
                    </div>
                </div>
            </div>
            
            <!-- Quick Actions -->
            <div class="bg-white rounded-lg shadow-md p-6 mt-6">
                <h3 class="font-bold mb-4">Quick Actions</h3>
                <div class="space-y-2">
                    <a href="/auth/change-password" 
                       class="block px-4 py-2 text-center bg-gray-100 text-gray-700 rounded hover:bg-gray-200">
                        Change Password
                    </a>
                    <a href="/admin/posts/new" 
                       class="block px-4 py-2 text-center bg-blue-100 text-blue-700 rounded hover:bg-blue-200">
                        New Post
                    </a>
                </div>
            </div>
        </div>
        
        <!-- Edit Profile Form -->
        <div class="md:col-span-2">
            <div class="bg-white rounded-lg shadow-md p-8">
                <h2 class="text-2xl font-bold mb-6">Edit Profile</h2>
                
                <form action="/admin/profile" method="POST" class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Username
                        </label>
                        <input type="text" 
                               value="<%= user.username %>"
                               disabled
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg bg-gray-50 text-gray-500 cursor-not-allowed">
                        <p class="text-xs text-gray-500 mt-1">Username cannot be changed</p>
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Display Name *
                        </label>
                        <input type="text" 
                               name="displayName" 
                               value="<%= user.displayName %>"
                               required
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Email *
                        </label>
                        <input type="email" 
                               name="email" 
                               value="<%= user.email %>"
                               required
                               class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Bio
                        </label>
                        <textarea name="bio" 
                                  rows="4"
                                  class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
                                  placeholder="Tell us about yourself..."><%= user.bio || '' %></textarea>
                        <p class="text-xs text-gray-500 mt-1">A short bio displayed on your posts</p>
                    </div>
                    
                    <div class="flex space-x-4">
                        <button type="submit" 
                                class="px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-medium">
                            Update Profile
                        </button>
                        <a href="/admin" 
                           class="px-6 py-3 bg-gray-200 text-gray-700 rounded-lg hover:bg-gray-300 text-center">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>