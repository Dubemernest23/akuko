<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Akuko</title>
    
    <!-- Tailwind CSS CDN for quick styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- <link rel="stylesheet" href="../public/css/style.css"> -->
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-md">
        <nav class="container mx-auto px-4 py-4">
            <div class="flex justify-between items-center">
                <a href="/" class="text-2xl font-bold text-blue-600">Akuko</a>
                
                <div class="hidden md:flex space-x-6">
                    <a href="/" class="hover:text-blue-600">Home</a>
                    <a href="/search" class="hover:text-blue-600">Search</a>
                    <% if (currentUser) { %>
                        <a href="/admin" class="hover:text-blue-600">Dashboard</a>
                        <a href="/auth/logout" class="hover:text-blue-600">Logout</a>
                    <% } else { %>
                        <a href="/auth/login" class="hover:text-blue-600">Login</a>
                    <% } %>
                </div>

                <!-- Mobile menu button -->
                <button id="mobile-menu-btn" class="md:hidden">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>

            <!-- Mobile menu -->
            <div id="mobile-menu" class="hidden md:hidden mt-4 space-y-2">
                <a href="/" class="block hover:text-blue-600">Home</a>
                <a href="/search" class="block hover:text-blue-600">Search</a>
                <% if (currentUser) { %>
                    <a href="/admin" class="block hover:text-blue-600">Dashboard</a>
                    <a href="/auth/logout" class="block hover:text-blue-600">Logout</a>
                <% } else { %>
                    <a href="/auth/login" class="block hover:text-blue-600">Login</a>
                <% } %>
            </div>
        </nav>
    </header>

    <!-- Flash Messages -->
    <% if (success && success.length > 0) { %>
        <div class="container mx-auto px-4 mt-4">
            <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded">
                <%= success %>
            </div>
        </div>
    <% } %>
    
    <% if (error && error.length > 0) { %>
        <div class="container mx-auto px-4 mt-4">
            <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded">
                <%= error %>
            </div>
        </div>
    <% } %>

    <!-- Main Content -->
    <main class="container mx-auto px-4 py-8">
        <%- body %>
    </main>

    <!-- Footer -->
    <footer class="bg-gray-800 text-white mt-16">
        <div class="container mx-auto px-4 py-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div>
                    <h3 class="text-xl font-bold mb-4">Akuko</h3>
                    <p class="text-gray-400">Personal thoughts and stories.</p>
                </div>
                <div>
                    <h3 class="text-xl font-bold mb-4">Links</h3>
                    <ul class="space-y-2">
                        <li><a href="/" class="text-gray-400 hover:text-white">Home</a></li>
                        <li><a href="/search" class="text-gray-400 hover:text-white">Search</a></li>
                        <% if (currentUser && currentUser.role === 'admin') { %>
                            <li><a href="/admin" class="text-gray-400 hover:text-white">Admin</a></li>
                        <% } %>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xl font-bold mb-4">Connect</h3>
                    <p class="text-gray-400">Built with ❤️ using Dapbase</p>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-8 text-center text-gray-400">
                <p>&copy; <%= new Date().getFullYear() %> Akuko. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Auto-hide flash messages
        setTimeout(function() {
            const alerts = document.querySelectorAll('.bg-green-100, .bg-red-100');
            alerts.forEach(alert => {
                alert.style.transition = 'opacity 0.5s';
                alert.style.opacity = '0';
                setTimeout(() => alert.remove(), 500);
            });
        }, 5000);
    </script>
    <script src="/js/main.js"></script>
    <!-- a<script src="../public/js/main.js"></script> -->
</body>
</html>