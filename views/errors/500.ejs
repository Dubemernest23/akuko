<div class="text-center py-16">
    <svg class="w-24 h-24 mx-auto text-red-300 mb-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
    </svg>
    
    <h1 class="text-6xl font-bold text-gray-300 mb-4">500</h1>
    <h2 class="text-3xl font-bold mb-4 text-gray-800"><%= title %></h2>
    <p class="text-gray-600 text-lg mb-8"><%= message %></p>
    
    <div class="space-x-4">
        <a href="/" 
           class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700">
            Go Home
        </a>
